
# Django configuration
# Copy this file to .env and replace the placeholder secret.
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,testserver
LOG_LEVEL=INFO
DEMO_ANOMALY_THRESHOLD=0.50

# Optional PostgreSQL database
# Leave DATABASE_URL unset to use SQLite locally.
# DATABASE_URL=postgresql://user:password@host:5432/database

# Optional trained model bundle directory
# MODEL_ARTIFACTS_DIR=model_artifacts

# Optional MLflow live tracing
# Install requirements-observability.txt first.
MLFLOW_TRACING_ENABLED=false

# Local MLflow URL; use your public HTTPS URL when hosted remotely.
MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# Optional MLflow authentication
# MLFLOW_TRACKING_USERNAME=admin
# MLFLOW_TRACKING_PASSWORD=

# Experiment for inference tracing
MLFLOW_EXPERIMENT_NAME=fraud-detection-inference

# Optional training experiment
# MLFLOW_TRAINING_EXPERIMENT_NAME=fraud-detection-training

# Optional MLflow tuning
# MLFLOW_RECONNECT_SECONDS=30
# MLFLOW_ARTIFACT_EVERY_N=25
# MLFLOW_ARTIFACT_EVERY_SECONDS=300
# MLFLOW_HTTP_REQUEST_TIMEOUT=10
# MLFLOW_HTTP_REQUEST_MAX_RETRIES=2

# Optional protection for GET /observability/status/
# OBSERVABILITY_STATUS_TOKEN=
