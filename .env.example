# Copy to .env for reference, then set these values in your shell/platform environment.
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,testserver
LOG_LEVEL=INFO
DEMO_ANOMALY_THRESHOLD=0.50
# Optional: PostgreSQL connection string; SQLite is used when unset.
# DATABASE_URL=postgresql://user:password@host:5432/database
# Optional trained model bundle directory. Requires requirements-ml.txt at runtime.
# MODEL_ARTIFACTS_DIR=model_artifacts

# ---- Optional MLflow live tracing (install requirements-observability.txt first) ----
MLFLOW_TRACING_ENABLED=false
# Local: http://127.0.0.1:5000   |   Render: the PUBLIC https URL of your MLflow server (never 127.0.0.1)
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
# Only if the MLflow server has login enabled:
# MLFLOW_TRACKING_USERNAME=admin
# MLFLOW_TRACKING_PASSWORD=
MLFLOW_EXPERIMENT_NAME=fraud-detection-inference
# Training runs (train_model.py --mlflow) use their own experiment:
# MLFLOW_TRAINING_EXPERIMENT_NAME=fraud-detection-training
# Tuning (all optional):
# MLFLOW_RECONNECT_SECONDS=30          # retry interval while the server is unreachable
# MLFLOW_ARTIFACT_EVERY_N=25           # upload monitoring/summary.json every N predictions
# MLFLOW_ARTIFACT_EVERY_SECONDS=300    # ...or at least this often when there is new data
# MLFLOW_HTTP_REQUEST_TIMEOUT=10
# MLFLOW_HTTP_REQUEST_MAX_RETRIES=2
# Protects GET /observability/status/ (send header X-Status-Token). Endpoint is hidden when unset.
# OBSERVABILITY_STATUS_TOKEN=
